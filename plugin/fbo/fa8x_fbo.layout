# FA8X Walkaround FBO v2, built by tools/fbo2/fbo2_export.py
# FBO frame: x right (east), y towards the airside door (north), z up, metres
room -21.25 13.75 -13.14 16.26 5
door -4.350 -1.950 15.980 16.260 0 2.8
start -12.750 -4.940 -30
# the crew room's computer (x0 x1 y0 y1 z0 z1): a click opens SimBrief's flight planning in the browser
pc 9.630 10.290 6.740 7.180 0.760 1.210
# the crew room's clocks for tools/mkclock.c: x of UTC, x of local, height, the wall's y (facing +y)
clocks 10.150 10.950 2.15 2.260
grid -21.250 -13.140 0.1 350 294
# the screens the plugin paints: lower left, lower right, upper right, upper left as seen from
# the room (12 numbers), then the rows of its 2048 x 1024 texture it fills (all 2:1: 1024)
arrivals -8.6560 -11.5900 1.6000 -8.6560 -9.4900 1.6000 -8.6560 -9.4900 2.6500 -8.6560 -11.5900 2.6500 1024
board 5.7300 -2.8040 1.6000 7.8300 -2.8040 1.6000 7.8300 -2.8040 2.6500 5.7300 -2.8040 2.6500 1024
board_vip -8.9740 -1.5400 1.4000 -8.9740 -3.6400 1.4000 -8.9740 -3.6400 2.4500 -8.9740 -1.5400 2.4500 1024
boarding -0.6500 16.1160 1.5500 0.7500 16.1160 1.5500 0.7500 16.1160 2.2500 -0.6500 16.1160 2.2500 1024
flight -8.9740 1.3600 1.4000 -8.9740 -0.7400 1.4000 -8.9740 -0.7400 2.4500 -8.9740 1.3600 2.4500 1024
handling 6.2600 -5.0870 0.8900 5.6400 -5.0870 0.8900 5.6400 -5.0870 1.2000 6.2600 -5.0870 1.2000 1024
handling 7.8600 -5.0870 0.8900 7.2400 -5.0870 0.8900 7.2400 -5.0870 1.2000 7.8600 -5.0870 1.2000 1024
notams 11.2400 7.0570 0.8900 11.8600 7.0570 0.8900 11.8600 7.0570 1.2000 11.2400 7.0570 1.2000 1024
ofp 9.2500 2.3040 1.1500 7.6500 2.3040 1.1500 7.6500 2.3040 1.9500 9.2500 2.3040 1.9500 1024
welcome 11.1000 -2.8040 1.6000 13.2000 -2.8040 1.6000 13.2000 -2.8040 2.6500 11.1000 -2.8040 2.6500 1024
wx 5.0500 2.3040 1.1500 3.4500 2.3040 1.1500 3.4500 2.3040 1.9500 5.0500 2.3040 1.9500 1024
wxmap 9.6400 7.0570 0.8900 10.2600 7.0570 0.8900 10.2600 7.0570 1.2000 9.6400 7.0570 1.2000 1024
wxtext 7.1500 2.3040 1.1500 5.5500 2.3040 1.1500 5.5500 2.3040 1.9500 7.1500 2.3040 1.9500 1024
# the room doors' leaves (fa8x_fbo_doors.obj, turned by fa8x/fbo/door_<n>, open on a click): the door's
# number, the hinge x y, the leaf's direction shut (degrees from +x, counter-clockwise), how far it
# turns open (signed), its width, bottom and top
swing 0 -0.888 9.760 0 -85 0.888 0.010 2.383
swing 0 0.888 9.760 180 85 0.888 0.010 2.383
swing 1 -0.888 7.460 0 -85 0.888 0.010 2.383
swing 1 0.888 7.460 180 85 0.888 0.010 2.383
