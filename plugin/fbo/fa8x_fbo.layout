swing 3 2.650 0.572 90 -85 0.876 0.010 2.183
swing 4 2.650 -1.778 90 -85 0.876 0.010 2.183
swing 5 9.912 -2.580 0 85 0.876 0.010 2.183
swing 6 -16.888 -10.140 0 -85 0.876 0.010 2.183
swing 7 -13.988 -10.140 0 -85 0.876 0.010 2.183
